<% if page.total_pages > 1 %>
  <nav class="pagination" aria-label="Pagination">
    <% if page.previous? %>
      <%= link_to "← Newer", url_for(request.query_parameters.merge(page: page.number - 1)), rel: "prev", class: "btn btn--ghost" %>
    <% else %>
      <span></span>
    <% end %>
    <span class="pagination__status">Page <%= page.number %> of <%= page.total_pages %></span>
    <% if page.next? %>
      <%= link_to "Older →", url_for(request.query_parameters.merge(page: page.number + 1)), rel: "next", class: "btn btn--ghost" %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
