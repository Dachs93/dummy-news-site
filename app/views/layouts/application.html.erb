<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="application-name" content="software-devs">
    <meta name="color-scheme" content="light dark">
    <meta property="og:site_name" content="software-devs">
    <meta property="og:title" content="<%= content_for(:title).presence || "software-devs" %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta name="twitter:card" content="<%= content_for?(:og_image) ? "summary_large_image" : "summary" %>">
    <link rel="canonical" href="<%= request.base_url + request.path %>">
    <link rel="alternate" type="application/atom+xml" title="software-devs" href="<%= feed_url %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "shared/header" %>
    <%= render "shared/flash" %>
    <main id="main" class="container">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
