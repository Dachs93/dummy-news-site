<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= [ content_for(:title), "Admin · software-devs" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <header class="admin-bar">
      <div class="container admin-bar__inner">
        <%= link_to admin_root_path, class: "logo logo--small" do %><span class="logo__prompt">&gt;_</span>software-devs <span class="badge">admin</span><% end %>
        <nav class="admin-nav" aria-label="Admin">
          <%= nav_link "Dashboard", admin_root_path %>
          <%= nav_link "Articles", admin_articles_path %>
          <%= nav_link "Topics", admin_categories_path %>
          <%= nav_link "Authors", admin_authors_path %>
          <%= nav_link "Images", admin_uploads_path %>
          <%= nav_link "Subscribers", admin_subscribers_path %>
        </nav>
        <div class="admin-bar__actions">
          <%= link_to "View site ↗", root_path, class: "muted-link" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn--ghost btn--sm" %>
        </div>
      </div>
    </header>
    <%= render "shared/flash" %>
    <main id="main" class="container admin-main">
      <%= yield %>
    </main>
  </body>
</html>
