<% content_for :title, "Reset password" %>
<div class="auth">
  <h1 class="page-title">Forgot your password?</h1>
  <%= form_with url: passwords_path, class: "form form--narrow" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="form__actions"><%= form.submit "Email reset instructions", class: "btn btn--primary" %></div>
  <% end %>
</div>
