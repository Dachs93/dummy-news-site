<article class="card<%= " card--image" if article.image? %>" style="<%= accent_style(article.category) %>">
  <%= cover_image(article, css_class: "card__image") %>
  <%= link_to article.category.name, category_path(article.category), class: "kicker kicker--accent" %>
  <h3 class="card__title"><%= link_to article.title, article_path(article) %></h3>
  <p class="card__excerpt"><%= article.excerpt %></p>
  <%= render "articles/meta", article: article %>
</article>
