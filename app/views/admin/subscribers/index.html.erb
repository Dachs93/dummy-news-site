<% content_for :title, "Subscribers" %>
<div class="admin-head">
  <h1 class="page-title">Subscribers</h1>
  <%= link_to "Export CSV", admin_subscribers_path(format: :csv), class: "btn btn--ghost" %>
</div>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Email</th><th>Subscribed</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
      <% @page.records.each do |subscriber| %>
        <tr>
          <td><%= subscriber.email %></td>
          <td><%= l subscriber.created_at, format: :short %></td>
          <td class="table__actions"><%= button_to "Remove", admin_subscriber_path(subscriber), method: :delete, class: "btn btn--ghost btn--sm", form: { data: { turbo_confirm: "Remove #{subscriber.email}?" } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% if @page.records.none? %><p class="muted">No subscribers yet.</p><% end %>
<%= render "shared/pagination", page: @page %>
