<% content_for :title, "Images" %>
<div class="admin-head">
  <div>
    <h1 class="page-title">Images</h1>
    <p class="muted">Upload an image, then paste its Markdown into an article body — or its path into <code>image:</code> in the front matter for a cover.</p>
  </div>
</div>

<%= form_with model: [ :admin, @upload ], class: "upload-form" do |f| %>
  <%= render "admin/shared/errors", record: @upload %>
  <div class="field">
    <%= f.label :file, "Image file" %>
    <%= f.file_field :file, accept: Upload::CONTENT_TYPES.join(","), required: true %>
    <small class="hint">PNG, JPEG, GIF, WebP or AVIF, up to <%= Upload::MAX_SIZE / 1.megabyte %> MB. Covers look best at 1200×630.</small>
  </div>
  <div class="field">
    <%= f.label :title, "Description (used as alt text)" %>
    <%= f.text_field :title, placeholder: "e.g. Architecture diagram of the deploy pipeline" %>
  </div>
  <%= f.submit "Upload", class: "btn btn--primary" %>
<% end %>

<% if @page.records.any? %>
  <ul class="upload-grid">
    <% @page.records.each do |upload| %>
      <% path = rails_blob_path(upload.file, only_path: true) %>
      <li class="upload-card">
        <img src="<%= path %>" alt="<%= upload.title %>" loading="lazy">
        <div class="upload-card__body">
          <strong><%= upload.title %></strong>
          <label class="hint" for="md-<%= upload.id %>">Body Markdown</label>
          <input id="md-<%= upload.id %>" class="copy-field" readonly value="![<%= upload.title %>](<%= path %> &quot;Caption&quot;)" onclick="this.select()">
          <label class="hint" for="cover-<%= upload.id %>">Cover front matter</label>
          <textarea id="cover-<%= upload.id %>" class="copy-field" readonly rows="2" onclick="this.select()">image: <%= path %>
image_alt: <%= upload.title %></textarea>
          <%= button_to "Delete", admin_upload_path(upload), method: :delete, class: "btn btn--ghost btn--sm", form: { data: { turbo_confirm: "Delete this image? Articles using it will show a broken image." } } %>
        </div>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", page: @page %>
<% else %>
  <p class="muted">No images uploaded yet.</p>
<% end %>
