<%= form_with model: [ :admin, category ], class: "form form--narrow" do |f| %>
  <%= render "admin/shared/errors", record: category %>
  <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
  <div class="field"><%= f.label :slug %><%= f.text_field :slug, placeholder: "generated-from-name" %></div>
  <div class="field"><%= f.label :description %><%= f.text_area :description, rows: 3 %></div>
  <div class="field"><%= f.label :position, "Menu position" %><%= f.number_field :position %></div>
  <div class="form__actions">
    <%= f.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_categories_path, class: "btn btn--ghost" %>
  </div>
<% end %>
