<% content_for :title, "Sign in" %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<div class="auth">
  <p class="kicker">Staff</p>
  <h1 class="page-title">Sign in</h1>
  <%= form_with url: session_path, class: "form form--narrow" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <div class="form__actions">
      <%= form.submit "Sign in", class: "btn btn--primary" %>
      <%= link_to "Forgot password?", new_password_path, class: "muted-link" %>
    </div>
  <% end %>
</div>
